{
  "definitions": [
    {
      "title": "Search",
      "id": "search",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Search",
              "model": "search",
              "key-value": true
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "search",
      "fields": [
        {
          "component": "aem-content",
          "name": "resultPageUrl",
          "label": "Search Results Page",
          "valueType": "string",
          "description": "Page to navigate to when a search term is selected"
        },
        {
          "component": "text",
          "name": "resultsApiEndpoint",
          "label": "Search Results API",
          "valueType": "string",
          "description": "Same-origin API for full search results (e.g. /api/search/results). Falls back to query index when empty."
        },
        {
          "component": "text",
          "name": "queryIndexSource",
          "label": "Query Index Source",
          "valueType": "string",
          "value": "/query-index.json",
          "description": "JSON index fallback when Results API is not configured"
        },
        {
          "component": "text",
          "name": "trendingApiEndpoint",
          "label": "Trending API Endpoint",
          "valueType": "string",
          "description": "Same-origin trending searches API. Trending section is shown only when configured."
        },
        {
          "component": "number",
          "name": "trendingLimit",
          "label": "Trending Items Limit",
          "valueType": "number",
          "value": 5
        },
        {
          "component": "number",
          "name": "recentSearchLimit",
          "label": "Recent Searches Limit",
          "valueType": "number",
          "value": 3
        },
        {
          "component": "text",
          "name": "suggestApiEndpoint",
          "label": "Autosuggest API Endpoint",
          "valueType": "string",
          "description": "Same-origin autosuggest API (e.g. /api/search/suggest)"
        },
        {
          "component": "text",
          "name": "searchQueryParam",
          "label": "Search Query Parameter",
          "valueType": "string",
          "value": "q",
          "description": "URL query parameter on the results page"
        },
        {
          "component": "text",
          "name": "suggestQueryParam",
          "label": "Suggest API Query Parameter",
          "valueType": "string",
          "value": "q"
        },
        {
          "component": "text",
          "name": "resultsQueryParam",
          "label": "Results API Query Parameter",
          "valueType": "string",
          "value": "q"
        },
        {
          "component": "text",
          "name": "locale",
          "label": "Locale / Market",
          "valueType": "string",
          "description": "Optional locale passed to search APIs (e.g. global/en)"
        }
      ]
    }
  ],
  "filters": []
}
