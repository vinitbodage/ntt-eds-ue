{
  "definitions": [
    {
      "title": "CF Teaser Selector",
      "id": "cf-teaser-selector",
      "model": "cf-teaser-selector",
      "plugins": {
        "da": {
          "unsafeHTML": "<div class=\"cf-teaser-selector\"><div><div><a href=\"\"></a></div></div><div><div><p></p></div></div></div>",
          "fields": [
            { "name": "cfpath", "selector": "div:nth-child(1)>div>a" },
            { "name": "contentFragmentVariation", "selector": "div:nth-child(2)>div>p" }
          ]
        }
      }
    }
  ],
  "models": [
    {
      "id": "cf-teaser-selector",
      "fields": [
        {
          "component": "aem-content-fragment",
          "name": "cfpath",
          "label": "Teaser Content Fragment Path",
          "variationName": "contentFragmentVariation",
          "validation": {
            "rootPath": "/content/dam"
          }
        },
        {
          "component": "text",
          "name": "contentFragmentVariation",
          "hidden": true
        },
        {
          "component": "select",
          "name": "classes_cta-position",
          "label": "CTA Position",
          "options": [
            { "name": "right", "value": "right" },
            { "name": "bottom", "value": "bottom" }
          ]
        },
        {
          "component": "select",
          "name": "classes_text-color",
          "label": "Text Color",
          "options": [
            { "name": "Bright", "value": "bright" },
            { "name": "Dark", "value": "dark" }
          ]
        }
      ]
    }
  ],
  "filters": []
}
